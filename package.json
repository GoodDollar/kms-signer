{
  "name": "@gooddollar/kms-ethereum-signing",
  "version": "1.0.4",
  "description": "Native Ethereum transaction signing using AWS KMS with secp256k1 support",
  "packageManager": "pnpm@12.18.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "setup": "ts-node src/cli/setup.ts",
    "import": "ts-node src/cli/import.ts",
    "sign": "ts-node src/cli/sign.ts",
    "submit": "ts-node src/cli/submit.ts",
    "list": "ts-node src/cli/list.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "aws",
    "kms",
    "ethereum",
    "blockchain",
    "secp256k1",
    "signing",
    "cryptocurrency"
  ],
  "author": "GoodDollar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoodDollar/kms-signer.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1168.0",
    "dotenv": "^16.6.1",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
